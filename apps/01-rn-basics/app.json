{
  "expo": {
    "name": "kksiazek-pokemony",
    "slug": "kksiazek-pokemony",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kksiazekpokemony",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.anonymous.kksiazek-pokemony",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) uses the camera to show your favorite Pokémon.",
        "NSPhotoLibraryAddUsageDescription": "$(PRODUCT_NAME) saves a photo of you with your favorite Pokémon."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.kksiazekpokemony"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-maps",
      [
        "expo-media-library",
        {
          "photosPermission": "$(PRODUCT_NAME) saves a photo of you with your favorite Pokémon.",
          "savePhotosPermission": "$(PRODUCT_NAME) saves a photo of you with your favorite Pokémon.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
