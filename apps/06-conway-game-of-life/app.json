{
  "expo": {
    "name": "06 Conway",
    "slug": "06-conway-game-of-life",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "conway06",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.anonymous.conway06",
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.conway06"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "expo-router",
      "react-native-webgpu",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
