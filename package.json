{
  "name": "rn-learning-hub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter 01-rn-basics typecheck",
    "export:native": "bun run --filter 01-rn-basics export:native",
    "start": "bun run --filter 01-rn-basics start",
    "ios": "bun run --filter 01-rn-basics ios",
    "android": "bun run --filter 01-rn-basics android"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4"
  }
}
